{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release @heojeongbo/fluxion-worker v${version}",
    "tagName": "fluxion-worker-v${version}",
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "push": true
  },
  "github": {
    "release": true,
    "releaseName": "fluxion-worker v${version}",
    "releaseNotes": null,
    "host": "github.com"
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": [
      "pnpm -w run build",
      "pnpm -w run typecheck",
      "pnpm -w run test",
      "pnpm -w run lint"
    ],
    "after:bump": ["echo 'Version bumped to ${version}'"],
    "after:release": [
      "echo 'Tagged ${name} v${version} — the release workflow publishes it on tag push. Watch: gh run watch'"
    ]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "context": {
        "host": "https://github.com",
        "owner": "heojeongbo",
        "repository": "fluxion-render"
      }
    }
  }
}
