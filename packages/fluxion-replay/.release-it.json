{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release @heojeongbo/fluxion-replay v${version}",
    "tagName": "fluxion-replay-v${version}",
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "push": true
  },
  "github": {
    "release": true,
    "releaseName": "fluxion-replay v${version}",
    "releaseNotes": null,
    "host": "github.com"
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": ["pnpm -w run verify:release"],
    "after:bump": ["echo 'Version bumped to ${version}'"],
    "after:release": [
      "echo 'Tagged ${name} v${version} \u2014 the release workflow publishes it on tag push. Watch: gh run watch'"
    ]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "context": {
        "host": "https://github.com",
        "owner": "heojeongbo",
        "repository": "fluxion-render"
      },
      "gitRawCommitsOpts": {
        "path": "."
      }
    }
  }
}
