{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release @heojeongbo/fluxion-render v${version}",
    "tagName": "fluxion-render-v${version}",
    "requireCleanWorkingDir": true,
    "requireBranch": "main",
    "push": true
  },
  "github": {
    "release": true,
    "releaseName": "fluxion-render v${version}",
    "releaseNotes": null,
    "host": "github.com"
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": [
      "pnpm --filter @heojeongbo/fluxion-render typecheck",
      "pnpm --filter @heojeongbo/fluxion-render test",
      "pnpm --filter @heojeongbo/fluxion-render build"
    ],
    "after:bump": ["echo 'Version bumped to ${version}'"],
    "after:release": [
      "pnpm publish --access public --registry https://registry.npmjs.org --no-git-checks",
      "echo 'Successfully released ${name} v${version} to ${repo.repository}.'"
    ]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "context": {
        "host": "https://github.com",
        "owner": "HeoJeongBo",
        "repository": "fluxion-render"
      }
    }
  }
}
